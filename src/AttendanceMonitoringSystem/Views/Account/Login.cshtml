@model AttendanceMonitoringSystem.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="auth-shell">
    <div class="auth-card">
        <h1>Log in</h1>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="field__error"></div>

            <div class="field">
                <label asp-for="Username">Username</label>
                <input asp-for="Username" type="text" />
                <span asp-validation-for="Username" class="field__error"></span>
            </div>

            <div class="field">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" type="password" />
                <span asp-validation-for="Password" class="field__error"></span>
            </div>

            <button type="submit" class="ams-btn ams-btn-primary ams-btn-block">Log in</button>
        </form>
    </div>
</div>