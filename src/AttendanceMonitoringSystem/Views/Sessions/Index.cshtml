@model List<AttendanceMonitoringSystem.Models.Session>

@{
    ViewData["Title"] = "Your Sessions";
}

<div class="page">
    <div class="page__header">
        <h1 class="page__title">Your sessions</h1>
    </div>

    <div class="table-card">
        @if (Model.Any())
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Module</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Type</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var session in Model)
                    {
                        <tr>
                            <td data-label="Module">@session.Module.Name</td>
                            <td data-label="Date">@session.Date.ToString("dd MMM yyyy")</td>
                            <td data-label="Time">@session.StartTime - @session.EndTime</td>
                            <td data-label="Type">@session.SessionType</td>
                            <td>
                                <div class="row-actions">
                                    <a class="ams-btn ams-btn-sm ams-btn-secondary" asp-controller="Students" asp-action="Index"
                                       asp-route-sessionId="@session.SessionId">
                                        View students
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="table-empty">You have no sessions scheduled.</p>
        }
    </div>
</div>