@startuml AttendanceMonitoringSystemC4L2
title C4 Level 2 Container Diagram – Attendance Monitoring System
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(student, "Student")
Person(tutor, "Tutor")
Person(moduleLeader, "Module Leader")
Person(courseLeader, "Course Leader")
Person(adviser, "Academic Adviser")
Person(admin, "Administrator")

System_Boundary(ams, "Attendance Monitoring System") {
    Container(lb, "Load Balancer", "Reverse proxy / load balancer", "Distributes incoming requests across Web Application instances.")
    Container(web1, "Web Application", "ASP.NET Core MVC, Razor views", "Instance 1. Serves pages to all user roles and handles attendance, reporting and user management.")
    Container(web2, "Web Application", "ASP.NET Core MVC, Razor views", "Instance 2. Serves pages to all user roles and handles attendance, reporting and user management.")
    Container(worker, "Background Worker", ".NET Worker Service", "Runs scheduled jobs: session finalisation (UC006) and external data sync.")
    ContainerDb(db, "Database", "SQL Server", "Primary. Stores users, roles, academic data and attendance records.")
    ContainerDb(dbStandby, "Database", "SQL Server", "Standby replica for failover.")
}

System_Ext(studentRecords, "Student Records System", "Provides student & course data")
System_Ext(timetabling, "Timetabling System", "Provides session & timetable data")
System_Ext(staffAlloc, "Staff Allocation System", "Provides academic staffing data")
System_Ext(advising, "Academic Advising System", "Provides adviser-to-advisee assignments")

Rel(student, lb, "Registers attendance, views own records", "HTTPS")
Rel(tutor, lb, "Records/corrects attendance, views reports", "HTTPS")
Rel(moduleLeader, lb, "Views module indicators & reports", "HTTPS")
Rel(courseLeader, lb, "Views course indicators & reports", "HTTPS")
Rel(adviser, lb, "Views advisee trends", "HTTPS")
Rel(admin, lb, "Creates users, allocates roles", "HTTPS")

Rel(lb, web1, "Routes requests to")
Rel(lb, web2, "Routes requests to")

Rel(web1, db, "Reads and writes attendance and user data", "Entity Framework Core")
Rel(web2, db, "Reads and writes attendance and user data", "Entity Framework Core")
Rel(worker, db, "Finalises sessions, stores synced data", "Entity Framework Core")

Rel(db, dbStandby, "Replicates to")

Rel(worker, studentRecords, "Reads student/course data from", "Scheduled sync")
Rel(worker, timetabling, "Reads session data from", "Scheduled sync")
Rel(worker, staffAlloc, "Reads staffing data from", "Scheduled sync")
Rel(worker, advising, "Reads adviser-to-advisee assignments from", "Scheduled sync")
@enduml