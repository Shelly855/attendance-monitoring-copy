@startuml AttendanceMonitoringSystem
!include <C4/C4_Context>
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

Person(student, "Student")
Person(tutor, "Tutor")
Person(moduleLeader, "Module Leader")
Person(courseLeader, "Course Leader")
Person(adviser, "Academic Adviser")
Person(admin, "Administrator")

System(ams, "Attendance Monitoring System")

System_Ext(studentRecords, "Student Records System", "Provides student & course data")
System_Ext(timetabling, "Timetabling System", "Provides session & timetable data")
System_Ext(staffAlloc, "Staff Allocation System", "Provides academic staffing data")
System_Ext(advising, "Academic Advising System", "Provides adviser-to-advisee assignments")

Rel(student, ams, "Registers attendance, views own records")
Rel(tutor, ams, "Records/corrects attendance")
Rel(moduleLeader, ams, "Views module indicators & reports")
Rel(courseLeader, ams, "Views course indicators & reports")
Rel(adviser, ams, "Views advisee trends")
Rel(admin, ams, "Creates users, allocates roles")

Rel(ams, studentRecords, "Reads student/course data from")
Rel(ams, timetabling, "Reads session data from")
Rel(ams, staffAlloc, "Reads staffing data from")
Rel(ams, advising, "Reads adviser-to-advisee assignments from")
@enduml