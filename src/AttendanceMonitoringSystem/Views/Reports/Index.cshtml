@model AttendanceMonitoringSystem.Models.AttendanceReport

@{
    ViewData["Title"] = "Attendance Report";
}

<div class="page" style="max-width:560px;">
    @if (ViewData["SessionId"] != null)
    {
        <a class="back-link" asp-controller="Students" asp-action="Index"
           asp-route-sessionId="@ViewData["SessionId"]">&larr; Back to students</a>
    }
    else
    {
        <a class="back-link" asp-controller="Sessions" asp-action="Index">&larr; Back to sessions</a>
    }

    <h1 class="page__title">Individual student attendance report</h1>

    <div class="summary-grid">
        <div class="summary-card summary-card--identity">
            <dl>
                <dd>@Model.StudentName</dd>
                <dd>@Model.Course</dd>
                <dd>@Model.ModuleName</dd>
                <dd>@Model.Semester</dd>
            </dl>
        </div>

        <div class="summary-card">
            <dl>
                <dt>Scheduled sessions</dt>
                <dd>@Model.ScheduledSessions</dd>
                <dt>Present</dt>
                <dd>@Model.PresentCount</dd>
                <dt>Absent</dt>
                <dd>@Model.AbsentCount</dd>
                <dt>Authorised absence</dt>
                <dd>@Model.AuthorisedAbsenceCount</dd>
                <dt>Late arrival</dt>
                <dd>@Model.LateArrivalCount</dd>
                <dt>Left early</dt>
                <dd>@Model.LeftEarlyCount</dd>
            </dl>
        </div>

        <div class="summary-card">
            <dl>
                <dt>Attendance percentage</dt>
                <dd>@Model.Percentage%</dd>
                <dt>Compliance status</dt>
                <dd>
                    <span class="compliance-pill compliance-pill--@(Model.IsCompliant ? "compliant" : "noncompliant")">
                        @(Model.IsCompliant ? "✓ Compliant" : "✕ Not compliant")
                    </span>
                </dd>
            </dl>
        </div>

        <div class="summary-card">
            <dl>
                <dt>Corrections</dt>
                <dd>@Model.CorrectionCount made</dd>
                @if (Model.LastCorrectionDate.HasValue)
                {
                    <dt>Last correction</dt>
                    <dd>@Model.LastCorrectionDate.Value.ToString("dd MMM yyyy HH:mm")</dd>
                }
            </dl>
            @if (Model.CorrectionCount > 0)
            {
                <div class="row-actions" style="justify-content:flex-start; margin-top: var(--space-3);">
                    <a class="ams-btn ams-btn-sm ams-btn-secondary" asp-action="History"
                       asp-route-studentId="@ViewData["StudentId"]" asp-route-moduleId="@ViewData["ModuleId"]"
                       asp-route-sessionId="@ViewData["SessionId"]">
                        View correction history
                    </a>
                </div>
            }
        </div>
    </div>
</div>