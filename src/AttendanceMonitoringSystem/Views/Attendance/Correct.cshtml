@model AttendanceMonitoringSystem.Models.CorrectAttendanceViewModel

@{
    ViewData["Title"] = "Correct Attendance";
}

<div class="page" style="max-width:480px;">
    <a class="back-link" asp-controller="Students" asp-action="Index" asp-route-sessionId="@Model.SessionId">&larr; Back
        to students</a>

        <h1 class="page__title">Correct attendance</h1>

        <div class="summary-card summary-card--identity" style="margin-bottom: var(--space-5);">
            <dl>
                <dd>@Model.StudentName</dd>
                <dd>Current status: @Model.CurrentStatus</dd>
            </dl>
        </div>

        <form asp-action="Correct" method="post">
            <input type="hidden" asp-for="AttendanceId" />
            <input type="hidden" asp-for="SessionId" />
            <div asp-validation-summary="ModelOnly" class="field__error"></div>

            <div class="field">
                <label asp-for="NewStatus">New status</label>
                <select asp-for="NewStatus">
                    <option value="">-- Select --</option>
                    <option value="Present">Present</option>
                    <option value="Absent">Absent</option>
                    <option value="Authorised Absence">Authorised Absence</option>
                    <option value="Late Arrival">Late Arrival</option>
                    <option value="Left Early">Left Early</option>
                </select>
                <span asp-validation-for="NewStatus" class="field__error"></span>
            </div>

            <div class="field">
                <label asp-for="Reason">Reason</label>
                <select asp-for="Reason">
                    <option value="">-- Select --</option>
                    <option value="Registration error">Registration error</option>
                    <option value="Technical problem">Technical problem</option>
                    <option value="Late arrival">Late arrival</option>
                    <option value="Authorised absence">Authorised absence</option>
                    <option value="Incorrect class or student selection">Incorrect class or student selection</option>
                    <option value="Other">Other</option>
                </select>
                <span asp-validation-for="Reason" class="field__error"></span>
            </div>

            <div class="field">
                <label asp-for="Explanation">Explanation (required if "Other")</label>
                <textarea asp-for="Explanation"></textarea>
                <span asp-validation-for="Explanation" class="field__error"></span>
            </div>

            <div class="row-actions" style="justify-content:flex-start; gap: var(--space-3);">
                <button type="submit" class="ams-btn ams-btn-primary">Save correction</button>
                <a class="ams-btn ams-btn-secondary" asp-controller="Students" asp-action="Index"
                   asp-route-sessionId="@Model.SessionId">Cancel</a>
            </div>
        </form>
    </div>