@model AttendanceMonitoringSystem.Models.AttendanceReport

@{
    ViewData["Title"] = "Attendance Report";
}

<h1>Individual Student Attendance Report</h1>

<p>Student: @Model.StudentName</p>
<p>Course: @Model.Course</p>
<p>Module: @Model.ModuleName</p>
<p>Period: @Model.Semester</p>

<h2>Attendance Summary</h2>
<ul>
    <li>Present: @Model.PresentCount</li>
    <li>Absent: @Model.AbsentCount</li>
    <li>Authorised Absence: @Model.AuthorisedAbsenceCount</li>
    <li>Late Arrival: @Model.LateArrivalCount</li>
    <li>Left Early: @Model.LeftEarlyCount</li>
    <li>Scheduled Sessions: @Model.ScheduledSessions</li>
</ul>

<p>Attendance Percentage: @Model.Percentage%</p>
<p>Compliance Status: @(Model.IsCompliant ? "✓ Compliant" : "✗ Not Compliant")</p>

<h2>Corrections</h2>
<p>@Model.CorrectionCount correction(s) made</p>
@if (Model.LastCorrectionDate.HasValue)
{
    <p>Last correction: @Model.LastCorrectionDate.Value.ToString("dd MMM yyyy HH:mm")</p>
}

<a asp-controller="Sessions" asp-action="Index">Back to Sessions</a>