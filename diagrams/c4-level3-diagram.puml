@startuml AttendanceMonitoringSystemC4L3
title C4 Level 3 Component Diagram – Attendance Monitoring System
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

Person(student, "Student")
Person(tutor, "Tutor")
Person(moduleLeader, "Module Leader")
Person(courseLeader, "Course Leader")
Person(adviser, "Academic Adviser")
Person(admin, "Administrator")

Container_Boundary(web, "Web Application") {
    Component(attendance, "Attendance Module", "C#, ASP.NET Core MVC", "Student registration, tutor recording, and overrides with change history (FR02, FR04-FR06).")
    Component(reporting, "Reporting Module", "C#, ASP.NET Core MVC", "Attendance views, indicators, trends, summaries and reports (FR03, FR07-FR15).")
    Component(access, "User and Access Module", "C#, ASP.NET Core MVC", "Login, user creation, role allocation, multiple roles and permission checks (FR16-FR18).")
    Component(academic, "Academic Structure Module", "C#, ASP.NET Core MVC", "Courses, modules, cohorts, sessions, groups, teaching teams and adviser assignments (FR19).")
}

ContainerDb(db, "Database", "SQL Server", "Stores users, roles, academic data and attendance records.")

Rel(student, attendance, "Registers attendance")
Rel(student, reporting, "Views own attendance")
Rel(tutor, attendance, "Records/corrects attendance")
Rel(tutor, reporting, "Views attendance reports")
Rel(moduleLeader, reporting, "Views module indicators & reports")
Rel(courseLeader, reporting, "Views course indicators & reports")
Rel(adviser, reporting, "Views advisee trends")
Rel(admin, access, "Creates users, allocates roles")

Rel(attendance, academic, "Checks student, class and teaching assignment", "In-process call")
Rel(attendance, access, "Reads TutorSession for authorisation", "Entity Framework Core")
Rel(reporting, attendance, "Reads attendance records", "In-process call")
Rel(reporting, academic, "Gets modules, cohorts and advisees in scope", "In-process call")
Rel(reporting, access, "Reads TutorSession for authorisation", "Entity Framework Core")

Rel(attendance, db, "Reads and writes attendance data", "Entity Framework Core")
Rel(access, db, "Reads and writes users and roles", "Entity Framework Core")
Rel(academic, db, "Reads and writes academic data", "Entity Framework Core")
@enduml